@model IEnumerable<NguyenMinhHa_BanGiay.Models.CartModel>
@{
    ViewData["Title"] = "Cart";
}
<div class="ticker">
    <div class="ticker-track">
        <div class="ticker-item">
            MIỄN PHÍ SHIP ĐƠN TRÊN 2 TRIỆU <span class="ticker-sep">★</span> XÁC
            THỰC 100% CHÍNH HÃNG <span class="ticker-sep">★</span> ĐỔI TRẢ 30 NGÀY
            <span class="ticker-sep">★</span>
        </div>
        <div class="ticker-item">
            MIỄN PHÍ SHIP ĐƠN TRÊN 2 TRIỆU <span class="ticker-sep">★</span> XÁC
            THỰC 100% CHÍNH HÃNG <span class="ticker-sep">★</span> ĐỔI TRẢ 30 NGÀY
            <span class="ticker-sep">★</span>
        </div>
    </div>
</div>

<div class="page-wrap">
    <div class="page-top">
        <div class="breadcrumb">
            <a href="@Url.Action("Index", "Home")">Home</a><span class="sep">/</span><span style="color: var(--text)">Cart</span>
        </div>
        <div class="page-title-row">
            <h1 class="page-title">
                YOUR<br /><span class="outline">CART</span>
            </h1>
            <span style="
              font-family: var(--mono);
              font-size: 11px;
              color: var(--muted);
              align-self: flex-end;
              padding-bottom: 8px;
            ">// @Model.Count() items</span>
        </div>
    </div>

    <div class="steps">
        <div class="step active"><span class="step-num">1</span>Cart</div>
        <div class="step-line"></div>
        <div class="step"><span class="step-num">2</span>Info</div>
        <div class="step-line"></div>
        <div class="step"><span class="step-num">3</span>Payment</div>
    </div>

    <div class="cart-layout">
        <!-- MAIN -->
        <div class="cart-main">
            <div class="cart-header">
                <span>Sản phẩm</span><span>Size</span><span>Đơn giá</span><span>Số lượng</span><span>Thành tiền</span>
            </div>

            @if (!Model.Any())
            {
                <div style="padding:48px;text-align:center;font-family:var(--mono);color:var(--muted);">
                    // Giỏ hàng trống. <a href="@Url.Action("Index","Product")" style="color:var(--accent);">Tiếp tục mua sắm →</a>
                </div>
            }
            @{
                int idx = 0;
            }
            @foreach (var item in Model)
            {
                string qId = "q" + idx;
                string pId = "p" + idx;
                string ciId = "ci" + idx;
                <div class="cart-item" id="@ciId">
                    <div class="item-prod">
                        <div class="item-img">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@Url.Content("~/upload/product/" + item.ImageUrl)"
                                     alt="@item.Name"
                                     style="width:80px;height:80px;object-fit:cover;border-radius:4px;" />
                            }
                            else
                            {
                                <div class="shoe-thumb c-black" style="width:64px;height:34px">
                                    <div class="s-upper" style="height:26px"></div>
                                    <div class="s-sole"></div>
                                    <div class="s-laces">
                                        <div class="s-lace" style="width:26px"></div>
                                        <div class="s-lace" style="width:22px"></div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="item-details">
                            <div class="item-name">@item.Name</div>
                            <div class="item-auth">
                                <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>Verified authentic
                            </div>
                            <form asp-action="RemoveCart" asp-controller="Cart" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="item-remove">
                                    <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                        <polyline points="3 6 5 6 21 6" />
                                        <path d="M19 6l-1 14H6L5 6" />
                                        <path d="M9 6V4h6v2" />
                                    </svg>Xóa
                                </button>
                            </form>
                        </div>
                    </div>
                    <div class="item-size-col" style="display:flex;align-items:center;justify-content:center;">
                        @if (!string.IsNullOrEmpty(item.Size))
                        {
                            <span class="sz" style="font-family:var(--mono);font-size:13px;padding:4px 10px;border:1px solid var(--border2);">@item.Size</span>
                        }
                        else
                        {
                            <span style="color:var(--muted);font-family:var(--mono);font-size:11px;">—</span>
                        }
                    </div>
                    <div class="item-price-col">
                        <span class="item-price">@item.Price.ToString("N0")₫</span>
                    </div>
                    <div style="display:flex;justify-content:center;">
                        <div class="qty-ctrl">
                            <form asp-action="UpdateQuantity" asp-controller="Cart" method="post" style="display:inline;">
                                <input type="hidden" name="productId" value="@item.Id" />
                                <input type="hidden" name="action" value="decrease" />
                                <button type="submit" class="qty-b">−</button>
                            </form>
                            <div class="qty-n">@item.Quantity</div>
                            <form asp-action="UpdateQuantity" asp-controller="Cart" method="post" style="display:inline;">
                                <input type="hidden" name="productId" value="@item.Id" />
                                <input type="hidden" name="action" value="increase" />
                                <button type="submit" class="qty-b">+</button>
                            </form>
                        </div>
                    </div>
                    <div class="item-total-col">
                        <span class="item-total">@item.Total.ToString("N0")₫</span>
                    </div>
                </div>
                idx++;
            }

            <div class="cart-actions">
                <a href="@Url.Action("Index", "Product")" class="back-link">← Tiếp tục mua sắm</a>
                <button class="update-btn">Cập nhật giỏ</button>
            </div>
        </div>

        <!-- SIDEBAR -->
        <div class="cart-sidebar">
            <h2 class="sidebar-title">ORDER<br />SUMMARY</h2>

            <div class="mini-items">
                @foreach (var item in Model)
                {
                    <div class="mini-item">
                        <div class="mini-img">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@Url.Content("~/upload/product/" + item.ImageUrl)"
                                     style="width:32px;height:32px;object-fit:cover;border-radius:3px;" />
                            }
                            else
                            {
                                <div class="shoe-thumb c-black" style="width:32px;height:17px">
                                    <div class="s-upper" style="height:13px"></div>
                                    <div class="s-sole" style="height:6px"></div>
                                </div>
                            }
                            <span class="mini-qty">@item.Quantity</span>
                        </div>
                        <div class="mini-info">
                            <div class="mini-name">@item.Name</div>
                        </div>
                        <div class="mini-price">@item.Total.ToString("N0")₫</div>
                    </div>
                }
            </div>
            <hr style="
              border: none;
              border-top: 1px solid var(--border);
              margin: 16px 0;
            " />
            <div class="sum-row">
                <span class="lbl">Tạm tính</span><span class="val" id="subtotal">@ViewData["SubTotal"]₫</span>
            </div>
            <div class="sum-row">
            </div>
            <div class="sum-row">
                <span class="lbl">Vận chuyển</span><span class="val free" id="shipping">Miễn phí</span>
            </div>
            <hr class="sum-div" />
            <div class="sum-total">
                <span class="lbl">Total</span><span class="val" id="grandTotal">@ViewData["Total"]₫</span>
            </div>
            <p class="sum-note">// Đã bao gồm VAT 10%</p>

            <a href="@Url.Action("Index", "Checkout")" class="btn-checkout">
                <svg width="14"
                     height="14"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     viewBox="0 0 24 24">
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                Checkout — @ViewData["Total"]₫
            </a>            
        </div>
    </div>
</div>
