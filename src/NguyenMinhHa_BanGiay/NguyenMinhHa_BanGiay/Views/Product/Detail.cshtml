@model NguyenMinhHa_BanGiay.Models.ProductModel
@{
    ViewData["Title"] = Model?.Name ?? "Chi tiết sản phẩm";
    var sizes = ViewBag.Size as List<NguyenMinhHa_BanGiay.Models.ProductSizeModel>;
}
<!-- TICKER -->
<div class="ticker">
    <div class="ticker-track">
        <div class="ticker-item">
            MIỄN PHÍ SHIP ĐƠN TRÊN 2 TRIỆU <span class="ticker-sep">★</span> XÁC
            THỰC 100% CHÍNH HÃNG <span class="ticker-sep">★</span> ĐỔI TRẢ 30 NGÀY
            <span class="ticker-sep">★</span> DROP MỚI MỖI THỨ SÁU
            <span class="ticker-sep">★</span>
        </div>
        <div class="ticker-item">
            MIỄN PHÍ SHIP ĐƠN TRÊN 2 TRIỆU <span class="ticker-sep">★</span> XÁC
            THỰC 100% CHÍNH HÃNG <span class="ticker-sep">★</span> ĐỔI TRẢ 30 NGÀY
            <span class="ticker-sep">★</span> DROP MỚI MỖI THỨ SÁU
            <span class="ticker-sep">★</span>
        </div>
    </div>
</div>

<!-- BREADCRUMB -->
<div class="breadcrumb">
    <a href="@Url.Action("Index", "Home")">Home</a><span class="sep">/</span>
    <a href="@Url.Action("Index", "Product")">Sneakers</a><span class="sep">/</span>
    @if (Model?.Category != null)
    {
        <a href="@Url.Action("Index", "Product", new { category = Model.Category.Slug })">@Model.Category.Name</a>

        <span class="sep">/</span>
    }
    <span style="color: var(--text)">@Model?.Name</span>
</div>

<!-- PRODUCT DETAIL -->
<div class="product-detail">
    <!-- GALLERY -->
    <div class="gallery">
        <div class="thumbs-rail">
        </div>
        <div class="gallery-main">
            <div class="main-display">
                @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                {
                    <img src="@Url.Content("~/upload/product/" + Model.ImageUrl)"
                         alt="@Model.Name" class="gallery-main-img" />
                }
                else
                {
                    <div class="shoe-3d">
                        <div class="s3-upper">
                            <div class="s3-collar"></div>
                            <div class="s3-tongue"></div>
                            <div class="s3-laces">
                                <div class="s3-lace" style="width: 70px"></div>
                                <div class="s3-lace" style="width: 60px"></div>
                                <div class="s3-lace" style="width: 50px"></div>
                                <div class="s3-lace" style="width: 40px"></div>
                            </div>
                            <div class="s3-swoosh"></div>
                        </div>
                        <div class="s3-midsole"></div>
                        <div class="s3-sole"></div>
                        <div class="s3-tag">NEW DROP</div>
                    </div>
                }
            </div>
            <div class="gallery-ctrl">
                <button class="gctrl-btn">←</button>
                <button class="gctrl-btn">→</button>
                <button class="gctrl-btn" title="Phóng to">⤢</button>
            </div>
        </div>
    </div>

    <!-- INFO PANEL -->
    <div class="info-panel">
        <div class="info-eyebrow">@(Model?.Category?.Name ?? "Sneakers")</div>
        <div class="info-brand">@(Model?.Category?.Name?.ToUpper() ?? "")</div>
        <h1 class="info-title">@(Model?.Name?.ToUpper())</h1>
        @if (!string.IsNullOrEmpty(Model?.Description))
        {
            <p class="info-subtitle">@Model.Description</p>
        }

        <div class="price-block">
            <div style="display: flex; align-items: baseline; gap: 4px">
                <span class="price-main">@Model?.Price.ToString("N0")₫</span>
            </div>
            <p class="price-note">
                // Giá đã bao gồm VAT · Miễn phí ship toàn quốc
            </p>
        </div>
        <!-- Size -->
        <div class="opt-block">
            <div class="opt-label">
                Size (US Men's):
                <span id="sizelabel" style="color: var(--accent)">Chưa chọn</span>
                <a href="#">Size Guide →</a>
            </div>
            <div class="size-grid">
                @if (sizes != null && sizes.Any())
                {
                    foreach (var s in sizes)
                    {
                        if (s.Quantity <= 0)
                        {
                            <button class="sz-opt sold" title="Hết hàng" disabled>@s.Size</button>
                        }
                        else
                        {
                            <button type="button" class="sz-opt" onclick="productSelectSize(this)">@s.Size</button>
                        }
                    }
                }
                else
                {
                    <p style="color:var(--muted);font-size:12px;font-family:var(--mono);">// Chưa có size</p>
                }
            </div>
            <p style="font-family:var(--mono);font-size:10px;color:var(--muted);margin-top:8px;">
                // Còn <span style="color:var(--accent2)">@(sizes?.Where(s => s.Quantity > 0).Count() ?? 0) size</span> đang có hàng
            </p>
        </div>

        <!-- QTY -->
        <div class="qty-row">
            <button type="button" class="qty-btn" onclick="productChangeQty(-1)">−</button>
            <div class="qty-num" id="qty">1</div>
            <button type="button" class="qty-btn" onclick="productChangeQty(1)">+</button>
        </div>

        <!-- CTA -->
        <form asp-controller="Cart" asp-action="AddToCart" method="get" onsubmit="return handleAddToCart(event)">
            <input type="hidden" name="Id" value="@Model.Id" />
            <input type="hidden" name="Name" value="@Model.Name" />
            <input type="hidden" name="Price" value="@Model.Price" />
            <input type="hidden" name="imageUrl" value="@Model.ImageUrl" />
            <input type="hidden" name="Type" value="0" /> 
            <input type="hidden" name="quantity" id="cartQty" value="1" />
            <input type="hidden" name="size" id="cartsize" value="" />

            <div class="cta-row">
                <button type="submit" class="btn-cart">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <path d="M16 10a4 4 0 0 1-8 0" />
                    </svg>
                    Thêm vào giỏ
                </button>
            </div>
        </form>
        
        <!-- TRUST -->
        <div class="trust-row">
            <div class="trust-item">
                <svg width="16"
                     height="16"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     viewBox="0 0 24 24">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
                <div class="trust-text">
                    <p>Auth 100%</p>
                    <p>Cam kết chính hãng</p>
                </div>
            </div>
            <div class="trust-item">
                <svg width="16"
                     height="16"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     viewBox="0 0 24 24">
                    <rect x="1" y="3" width="15" height="13" />
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
                    <circle cx="5.5" cy="18.5" r="2.5" />
                    <circle cx="18.5" cy="18.5" r="2.5" />
                </svg>
                <div class="trust-text">
                    <p>Free Shipping</p>
                    <p>Giao toàn quốc 48H</p>
                </div>
            </div>
            <div class="trust-item">
                <svg width="16"
                     height="16"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     viewBox="0 0 24 24">
                    <polyline points="1 4 1 10 7 10" />
                    <path d="M3.51 15a9 9 0 1 0 .49-3.5" />
                </svg>
                <div class="trust-text">
                    <p>Đổi trả 30 ngày</p>
                    <p>Miễn phí đổi size</p>
                </div>
            </div>
        </div>

        <!-- TABS -->
        <div class="tabs-nav">
            <button class="tab-btn active" onclick="openTab(this, 'desc')">
                Mô tả
            </button>
            <button class="tab-btn" onclick="openTab(this, 'specs')">
                Thông số
            </button>
        </div>

        <div class="tab-content active" id="tab-desc">
            @if (!string.IsNullOrEmpty(Model?.Content))
            {
                @Html.Raw(Model.Content)
            }
            else if (!string.IsNullOrEmpty(Model?.Description))
            {
                <p>@Model.Description</p>
            }
            else
            {
                <p style="color:var(--muted);">// Chưa có mô tả sản phẩm.</p>
            }
        </div>
        <div class="tab-content" id="tab-specs">
            <table class="spec-tbl">
                <tr><td>Tên sản phẩm</td><td>@Model?.Name</td></tr>
                <tr><td>Danh mục</td><td>@(Model?.Category?.Name ?? "—")</td></tr>
                <tr><td>Giá</td><td>@Model?.Price.ToString("N0")₫</td></tr>
                <tr><td>Số lượng kho</td><td>@Model?.Quantity</td></tr>
                <tr><td>Ngày nhập</td><td>@Model?.Created_at.ToString("dd/MM/yyyy")</td></tr>
                @if (sizes != null && sizes.Any())
                {
                    <tr>
                        <td>Size có sẵn</td>
                        <td>@string.Join(", ", sizes.Where(s => s.Quantity > 0).Select(s => s.Size))</td>
                    </tr>
                }
            </table>
        </div>
    </div>
    <!-- end info-panel -->
</div>
<!-- end product-detail -->
<!-- RELATED -->
<section class="related">
    <div class="rel-eyebrow">You May Also Like</div>
    <h2 class="rel-title">RELATED DROPS</h2>
    <div class="rel-grid">
        @{
            var related = ViewBag.Related as List<NguyenMinhHa_BanGiay.Models.ProductModel>;
            var colorClasses = new[] { "c-white", "c-red", "c-blue", "c-orange", "c-green", "c-black" };
            int ri = 0;
        }
        @if (related != null && related.Any())
        {
            foreach (var rel in related.Take(4))
            {
                string relUrl = Url.Action("Detail", "Product", new { Id = rel.Id });
                <div class="rel-card" onclick="window.location='@relUrl'" style="cursor:pointer;">
                    <div class="rel-img">
                        @if (!string.IsNullOrEmpty(rel.ImageUrl))
                        {
                            <img src="@Url.Content("~/upload/product/" + rel.ImageUrl)" alt="@rel.Name" class="rel-main-img" />
                        }
                        else
                        {
                            string rc = colorClasses[ri % colorClasses.Length];
                            <div class="shoe-thumb @rc" style="width:120px;height:64px">
                                <div class="s-upper" style="height:50px"></div>
                                <div class="s-sole"></div>
                                <div class="s-laces">
                                    <div class="s-lace" style="width:48px"></div>
                                    <div class="s-lace" style="width:40px"></div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="rel-info">
                        <div class="rel-brand">@(rel.Category?.Name ?? "")</div>
                        <div class="rel-name"><a href="@relUrl">@rel.Name</a></div>
                        <div class="rel-price">@rel.Price.ToString("N0")₫</div>
                    </div>
                </div>
                ri++;
            }
        }
    </div>
</section>
<script>
    // 1. Hàm chọn size chuẩn hóa, không bị detail.js ghi đè
    function productSelectSize(btn) {
        // Xóa active của các nút khác và thêm vào nút hiện tại
        document.querySelectorAll('.sz-opt').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Lấy giá trị size từ chữ trên nút bấm
        var sizeVal = btn.innerText.trim();

        // Tìm các phần tử trên giao diện theo ID viết thường
        var lbl = document.getElementById('sizelabel');
        var inputSize = document.getElementById('cartsize');

        // Kiểm tra an toàn trước khi gán giá trị để tránh lỗi "Cannot set properties of null"
        if (lbl) {
            lbl.textContent = "US " + sizeVal;
        } else {
            console.error("Không tìm thấy phần tử có id='sizelabel' trên trang!");
        }

        if (inputSize) {
            inputSize.value = sizeVal;
            console.log("=== ĐÃ LẤY SIZE THÀNH CÔNG ===");
            console.log("Giá trị nạp vào input ẩn:", inputSize.value);
        } else {
            console.error("Không tìm thấy phần tử có id='cartsize' trên trang!");
        }
    }

    // 2. Hàm tăng giảm số lượng
    var currentProductQty = 1; // Khởi tạo biến đếm nội bộ

    function productChangeQty(delta) {
        // Giới hạn số lượng tối thiểu là 1, tối đa là 10 (bạn có thể tăng nếu muốn)
        currentProductQty = Math.max(1, Math.min(10, currentProductQty + delta));

        var qtyText = document.getElementById('qty');
        var qtyInput = document.getElementById('cartQty');

        // Gán số lượng mới hiển thị ra giao diện
        if (qtyText) {
            qtyText.textContent = currentProductQty;
        }

        // Nạp số lượng mới vào ô input ẩn để sẵn sàng gửi lên Controller
        if (qtyInput) {
            qtyInput.value = currentProductQty;
        }

        // Xuất log trực quan dưới F12 cho bạn kiểm tra
        console.log("=== CẬP NHẬT SỐ LƯỢNG ===");
        console.log("Số lượng hiển thị trên web:", currentProductQty);
        console.log("Giá trị thực tế trong input ẩn (gửi đi):", qtyInput ? qtyInput.value : "Không tìm thấy input cartQty");
    }

    // 3. Hàm kiểm tra chặn Submit nếu chưa chọn size
    function handleAddToCart(e) {
        var hasSizesOnUI = document.querySelectorAll('.sz-opt').length > 0;
        var sizeInput = document.getElementById('cartsize');
        var selectedSize = sizeInput ? sizeInput.value.trim() : "";

        if (hasSizesOnUI && selectedSize === "") {
            e.preventDefault(); // Chặn gửi form

            // Nháy đỏ cảnh báo trực quan
            var grid = document.querySelector('.size-grid');
            if (grid) {
                grid.style.outline = '2px solid red';
                grid.style.borderRadius = '4px';
                setTimeout(() => { grid.style.outline = ''; }, 1500);
            }

            alert("Vui lòng chọn Size giày trước khi thêm vào giỏ hàng!");
            return false;
        }
        return true;
    }
</script>