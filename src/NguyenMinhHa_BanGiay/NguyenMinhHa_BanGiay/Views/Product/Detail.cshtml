<!-- BREADCRUMB -->
<div class="breadcrumb">
    <a href="sole-index.html">Home</a><span class="sep">/</span>
    <a href="sole-products.html">Sneakers</a><span class="sep">/</span>
    <a href="sole-products.html">Nike</a><span class="sep">/</span>
    <span style="color: var(--text)">Air Jordan 1 Retro High OG</span>
</div>

<!-- PRODUCT DETAIL -->
<div class="product-detail">
    <!-- GALLERY -->
    <div class="gallery">
        <div class="thumbs-rail">
            <div class="thumb active">
                <div style="
                width: 32px;
                height: 40px;
                background: linear-gradient(160deg, #2a2a2a, #111);
                border-radius: 4px 20px 4px 4px;
                position: relative;
              ">
                    <div style="
                  position: absolute;
                  bottom: 0;
                  left: -3px;
                  right: -3px;
                  height: 7px;
                  background: var(--accent);
                  border-radius: 1px 18px 4px 1px;
                "></div>
                </div>
            </div>
            <div class="thumb">
                <div style="
                width: 36px;
                height: 24px;
                background: linear-gradient(160deg, #2a2a2a, #111);
                border-radius: 3px 24px 3px 3px;
                position: relative;
              ">
                    <div style="
                  position: absolute;
                  bottom: 0;
                  left: -3px;
                  right: -3px;
                  height: 6px;
                  background: var(--accent);
                  border-radius: 1px 16px 3px 1px;
                "></div>
                </div>
            </div>
            <div class="thumb">
                <div style="
                width: 40px;
                height: 16px;
                background: #1a1a1a;
                border-radius: 2px;
                border: 1px solid var(--border2);
              "></div>
            </div>
            <div class="thumb">
                <div style="
                width: 34px;
                height: 36px;
                background: linear-gradient(180deg, #222, #111);
                border-radius: 3px;
                border: 1px solid rgba(232, 255, 0, 0.1);
              "></div>
            </div>
        </div>
        <div class="gallery-main">
            <div class="gallery-badge">
                <span class="g-badge auth">✓ Auth Verified</span>
                <span class="g-badge limited">Limited Drop</span>
            </div>
            <div class="main-display">
                <div class="shoe-3d">
                    <div class="s3-upper">
                        <div class="s3-collar"></div>
                        <div class="s3-tongue"></div>
                        <div class="s3-laces">
                            <div class="s3-lace" style="width: 70px"></div>
                            <div class="s3-lace" style="width: 60px"></div>
                            <div class="s3-lace" style="width: 50px"></div>
                            <div class="s3-lace" style="width: 40px"></div>
                        </div>
                        <div class="s3-swoosh"></div>
                    </div>
                    <div class="s3-midsole"></div>
                    <div class="s3-sole"></div>
                    <div class="s3-tag">NEW DROP</div>
                </div>
            </div>
            <div class="gallery-ctrl">
                <button class="gctrl-btn">←</button>
                <button class="gctrl-btn">→</button>
                <button class="gctrl-btn" title="Phóng to">⤢</button>
            </div>
        </div>
    </div>

    <!-- INFO PANEL -->
    <div class="info-panel">
        <div class="info-eyebrow">Nike / Jordan Brand</div>
        <div class="info-brand">NIKE</div>
        <h1 class="info-title">AIR JORDAN 1<br />RETRO HIGH OG</h1>
        <p class="info-subtitle">Black / Opti Yellow / White — FD1437-701</p>

        <div class="rating-row">
            <span class="stars">★★★★★</span>
            <span class="rating-num">4.9</span>
            <span class="rating-sep">·</span>
            <a href="#" class="rev-link">86 đánh giá</a>
            <span class="rating-sep">·</span>
            <span class="verified">
                <svg width="12"
                     height="12"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     viewBox="0 0 24 24">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
                Auth Verified
            </span>
        </div>

        <div class="price-block">
            <div style="display: flex; align-items: baseline; gap: 4px">
                <span class="price-main">5.200.000₫</span>
            </div>
            <p class="price-note">
                // Giá đã bao gồm VAT · Miễn phí ship toàn quốc
            </p>
        </div>

        <!-- Color -->
        <div class="opt-block">
            <div class="opt-label">
                Màu sắc:
                <span id="colorLabel" style="color: var(--text)">Black / Yellow</span>
            </div>
            <div class="color-opts">
                <div class="c-opt active"
                     style="
                background: linear-gradient(
                  135deg,
                  #111 50%,
                  var(--accent) 50%
                );
              "
                     onclick="selectColor(this, 'Black / Yellow')"
                     title="Black / Yellow"></div>
                <div class="c-opt"
                     style="
                background: linear-gradient(135deg, #e0e0e0 50%, #c0392b 50%);
              "
                     onclick="selectColor(this, 'White / Red')"
                     title="White / Red"></div>
                <div class="c-opt"
                     style="
                background: linear-gradient(135deg, #1a5276 50%, #f0f0f0 50%);
              "
                     onclick="selectColor(this, 'Royal Blue / White')"
                     title="Royal Blue"></div>
                <div class="c-opt"
                     style="
                background: linear-gradient(135deg, #1e8449 50%, #f5f5f0 50%);
              "
                     onclick="selectColor(this, 'Dark Mocha')"
                     title="Dark Mocha"></div>
            </div>
        </div>

        <!-- Size -->
        <div class="opt-block">
            <div class="opt-label">
                Size (US Men's):
                <span id="sizeLabel" style="color: var(--accent)">Chưa chọn</span>
                <a href="#">Size Guide →</a>
            </div>
            <div class="size-grid">
                <button class="sz-opt sold" title="Hết hàng">6 / 38</button>
                <button class="sz-opt" onclick="selectSize(this, '6.5')">
                    6.5 / 39
                </button>
                <button class="sz-opt" onclick="selectSize(this, '7')">
                    7 / 40
                </button>
                <button class="sz-opt active" onclick="selectSize(this, '7.5')">
                    7.5 / 41
                </button>
                <button class="sz-opt" onclick="selectSize(this, '8')">
                    8 / 42
                </button>
                <button class="sz-opt" onclick="selectSize(this, '8.5')">
                    8.5 / 43
                </button>
                <button class="sz-opt" onclick="selectSize(this, '9')">
                    9 / 44
                </button>
                <button class="sz-opt sold" title="Hết hàng">9.5 / 44.5</button>
                <button class="sz-opt" onclick="selectSize(this, '10')">
                    10 / 45
                </button>
                <button class="sz-opt" onclick="selectSize(this, '11')">
                    11 / 46
                </button>
                <button class="sz-opt sold" title="Hết hàng">12 / 47</button>
                <button class="sz-opt" onclick="selectSize(this, '13')">
                    13 / 48
                </button>
            </div>
            <p style="
              font-family: var(--mono);
              font-size: 10px;
              color: var(--muted);
              margin-top: 8px;
            ">
                // Chỉ còn <span style="color: var(--accent2)">3 đôi</span> size 7–9
            </p>
        </div>

        <!-- QTY -->
        <div class="qty-row">
            <button class="qty-btn" onclick="changeQty(-1)">−</button>
            <div class="qty-num" id="qty">1</div>
            <button class="qty-btn" onclick="changeQty(1)">+</button>
        </div>

        <!-- CTA -->
        <div class="cta-row">
            <button class="btn-cart" onclick="window.location = 'sole-cart.html'">
                <svg width="16"
                     height="16"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     viewBox="0 0 24 24">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <path d="M16 10a4 4 0 0 1-8 0" />
                </svg>
                Thêm vào giỏ
            </button>
            <button class="btn-wish">♡</button>
        </div>
        <button class="btn-buy"
                style="width: 100%; margin-bottom: 24px"
                onclick="window.location = 'sole-checkout.html'">
            ⚡ MUA NGAY — 5.200.000₫
        </button>

        <!-- TRUST -->
        <div class="trust-row">
            <div class="trust-item">
                <svg width="16"
                     height="16"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     viewBox="0 0 24 24">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
                <div class="trust-text">
                    <p>Auth 100%</p>
                    <p>Cam kết chính hãng</p>
                </div>
            </div>
            <div class="trust-item">
                <svg width="16"
                     height="16"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     viewBox="0 0 24 24">
                    <rect x="1" y="3" width="15" height="13" />
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
                    <circle cx="5.5" cy="18.5" r="2.5" />
                    <circle cx="18.5" cy="18.5" r="2.5" />
                </svg>
                <div class="trust-text">
                    <p>Free Shipping</p>
                    <p>Giao toàn quốc 48H</p>
                </div>
            </div>
            <div class="trust-item">
                <svg width="16"
                     height="16"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     viewBox="0 0 24 24">
                    <polyline points="1 4 1 10 7 10" />
                    <path d="M3.51 15a9 9 0 1 0 .49-3.5" />
                </svg>
                <div class="trust-text">
                    <p>Đổi trả 30 ngày</p>
                    <p>Miễn phí đổi size</p>
                </div>
            </div>
        </div>

        <!-- TABS -->
        <div class="tabs-nav">
            <button class="tab-btn active" onclick="openTab(this, 'desc')">
                Mô tả
            </button>
            <button class="tab-btn" onclick="openTab(this, 'specs')">
                Thông số
            </button>
            <button class="tab-btn" onclick="openTab(this, 'auth')">
                Xác thực
