@model NguyenMinhHa_BanGiay.Models.ProductModel
@{
    ViewData["Title"] = Model?.Name ?? "Chi tiết sản phẩm";
    var sizes = ViewBag.Size as List<NguyenMinhHa_BanGiay.Models.ProductSizeModel>;
}
<!-- TICKER -->
<div class="ticker">
    <div class="ticker-track">
        <div class="ticker-item">
            MIỄN PHÍ SHIP ĐƠN TRÊN 2 TRIỆU <span class="ticker-sep">★</span> XÁC
            THỰC 100% CHÍNH HÃNG <span class="ticker-sep">★</span> ĐỔI TRẢ 30 NGÀY
            <span class="ticker-sep">★</span> DROP MỚI MỖI THỨ SÁU
            <span class="ticker-sep">★</span>
        </div>
        <div class="ticker-item">
            MIỄN PHÍ SHIP ĐƠN TRÊN 2 TRIỆU <span class="ticker-sep">★</span> XÁC
            THỰC 100% CHÍNH HÃNG <span class="ticker-sep">★</span> ĐỔI TRẢ 30 NGÀY
            <span class="ticker-sep">★</span> DROP MỚI MỖI THỨ SÁU
            <span class="ticker-sep">★</span>
        </div>
    </div>
</div>

<!-- BREADCRUMB -->
<div class="breadcrumb">
    <a href="@Url.Action("Index", "Home")">Home</a><span class="sep">/</span>
    <a href="@Url.Action("Index", "Product")">Sneakers</a><span class="sep">/</span>
    @if (Model?.Category != null)
    {
        <a href="@Url.Action("Index", "Product", new { category = Model.Category.Slug })">@Model.Category.Name</a>

        <span class="sep">/</span>
    }
    <span style="color: var(--text)">@Model?.Name</span>
</div>

<!-- PRODUCT DETAIL -->
<div class="product-detail">
    <!-- GALLERY -->
    <div class="gallery">
        <div class="thumbs-rail">
            <div class="thumb active">
                <div style="
                width: 32px;
                height: 40px;
                background: linear-gradient(160deg, #2a2a2a, #111);
                border-radius: 4px 20px 4px 4px;
                position: relative;
              ">
                    <div style="
                  position: absolute;
                  bottom: 0;
                  left: -3px;
                  right: -3px;
                  height: 7px;
                  background: var(--accent);
                  border-radius: 1px 18px 4px 1px;
                "></div>
                </div>
            </div>
            <div class="thumb">
                <div style="
                width: 36px;
                height: 24px;
                background: linear-gradient(160deg, #2a2a2a, #111);
                border-radius: 3px 24px 3px 3px;
                position: relative;
              ">
                    <div style="
                  position: absolute;
                  bottom: 0;
                  left: -3px;
                  right: -3px;
                  height: 6px;
                  background: var(--accent);
                  border-radius: 1px 16px 3px 1px;
                "></div>
                </div>
            </div>
            <div class="thumb">
                <div style="
                width: 40px;
                height: 16px;
                background: #1a1a1a;
                border-radius: 2px;
                border: 1px solid var(--border2);
              "></div>
            </div>
            <div class="thumb">
                <div style="
                width: 34px;
                height: 36px;
                background: linear-gradient(180deg, #222, #111);
                border-radius: 3px;
                border: 1px solid rgba(232, 255, 0, 0.1);
              "></div>
            </div>
        </div>
        <div class="gallery-main">
            <div class="gallery-badge">
                <span class="g-badge auth">✓ Auth Verified</span>
                <span class="g-badge limited">Limited Drop</span>
            </div>
            <div class="main-display">
                <div class="shoe-3d">
                    <div class="s3-upper">
                        <div class="s3-collar"></div>
                        <div class="s3-tongue"></div>
                        <div class="s3-laces">
                            <div class="s3-lace" style="width: 70px"></div>
                            <div class="s3-lace" style="width: 60px"></div>
                            <div class="s3-lace" style="width: 50px"></div>
                            <div class="s3-lace" style="width: 40px"></div>
                        </div>
                        <div class="s3-swoosh"></div>
                    </div>
                    <div class="s3-midsole"></div>
                    <div class="s3-sole"></div>
                    <div class="s3-tag">NEW DROP</div>
                </div>
            </div>
            <div class="gallery-ctrl">
                <button class="gctrl-btn">←</button>
                <button class="gctrl-btn">→</button>
                <button class="gctrl-btn" title="Phóng to">⤢</button>
            </div>
        </div>
    </div>

    <!-- INFO PANEL -->
    <div class="info-panel">
        <div class="info-eyebrow">@(Model?.Category?.Name ?? "Sneakers")</div>
        <div class="info-brand">@(Model?.Category?.Name?.ToUpper() ?? "")</div>
        <h1 class="info-title">@(Model?.Name?.ToUpper())</h1>
        @if (!string.IsNullOrEmpty(Model?.Description))
        {
            <p class="info-subtitle">@Model.Description</p>
        }

        <div class="rating-row">
            <span class="stars">★★★★★</span>
            <span class="rating-num">4.9</span>
            <span class="rating-sep">·</span>
            <a href="#" class="rev-link">86 đánh giá</a>
            <span class="rating-sep">·</span>
            <span class="verified">
                <svg width="12"
                     height="12"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     viewBox="0 0 24 24">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
                Auth Verified
            </span>
        </div>

        <div class="price-block">
            <div style="display: flex; align-items: baseline; gap: 4px">
                <span class="price-main">@Model?.Price.ToString("N0")₫</span>
            </div>
            <p class="price-note">
                // Giá đã bao gồm VAT · Miễn phí ship toàn quốc
            </p>
        </div>

        <!-- Color -->
        <div class="opt-block">
            <div class="opt-label">
                Màu sắc:
                <span id="colorLabel" style="color: var(--text)">Black / Yellow</span>
            </div>
            <div class="color-opts">
                <div class="c-opt active"
                     style="
                background: linear-gradient(
                  135deg,
                  #111 50%,
                  var(--accent) 50%
                );
              "
                     onclick="selectColor(this, 'Black / Yellow')"
                     title="Black / Yellow"></div>
                <div class="c-opt"
                     style="
                background: linear-gradient(135deg, #e0e0e0 50%, #c0392b 50%);
              "
                     onclick="selectColor(this, 'White / Red')"
                     title="White / Red"></div>
                <div class="c-opt"
                     style="
                background: linear-gradient(135deg, #1a5276 50%, #f0f0f0 50%);
              "
                     onclick="selectColor(this, 'Royal Blue / White')"
                     title="Royal Blue"></div>
                <div class="c-opt"
                     style="
                background: linear-gradient(135deg, #1e8449 50%, #f5f5f0 50%);
              "
                     onclick="selectColor(this, 'Dark Mocha')"
                     title="Dark Mocha"></div>
            </div>
        </div>

        <!-- Size -->
        <div class="opt-block">
            <div class="opt-label">
                Size (US Men's):
                <span id="sizeLabel" style="color: var(--accent)">Chưa chọn</span>
                <a href="#">Size Guide →</a>
            </div>
            <div class="size-grid">
                @if (sizes != null && sizes.Any())
                {
                    foreach (var s in sizes)
                    {
                        if (s.Quantity <= 0)
                        {
                            <button class="sz-opt sold" title="Hết hàng" disabled>@s.size</button>
                        }
                        else
                        {
                            <button class="sz-opt" onclick="selectSize(this, '@s.size')">@s.size</button>
                        }
                    }
                }
                else
                {
                    <p style="color:var(--muted);font-size:12px;font-family:var(--mono);">// Chưa có size</p>
                }
            </div>
            <p style="font-family:var(--mono);font-size:10px;color:var(--muted);margin-top:8px;">
                // Còn <span style="color:var(--accent2)">@(sizes?.Where(s => s.Quantity > 0).Count() ?? 0) size</span> đang có hàng
            </p>
        </div>

        <!-- QTY -->
        <div class="qty-row">
            <button class="qty-btn" onclick="changeQty(-1)">−</button>
            <div class="qty-num" id="qty">1</div>
            <button class="qty-btn" onclick="changeQty(1)">+</button>
        </div>

        <!-- CTA -->
        <div class="cta-row">
            <button class="btn-cart" onclick="addToCart(@Model.Id, document.querySelector('.sz-opt.active')?.dataset?.size)">
                <svg width="16"
                     height="16"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     viewBox="0 0 24 24">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <path d="M16 10a4 4 0 0 1-8 0" />
                </svg>
                Thêm vào giỏ
            </button>
            <button class="btn-wish">♡</button>
        </div>
        <button class="btn-buy"
                style="width: 100%; margin-bottom: 24px"
                onclick="window.location='@Url.Action("Index", "Checkout")'">
            ⚡ MUA NGAY — @Model?.Price.ToString("N0")₫
        </button>

        <!-- TRUST -->
        <div class="trust-row">
            <div class="trust-item">
                <svg width="16"
                     height="16"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     viewBox="0 0 24 24">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
                <div class="trust-text">
                    <p>Auth 100%</p>
                    <p>Cam kết chính hãng</p>
                </div>
            </div>
            <div class="trust-item">
                <svg width="16"
                     height="16"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     viewBox="0 0 24 24">
                    <rect x="1" y="3" width="15" height="13" />
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
                    <circle cx="5.5" cy="18.5" r="2.5" />
                    <circle cx="18.5" cy="18.5" r="2.5" />
                </svg>
                <div class="trust-text">
                    <p>Free Shipping</p>
                    <p>Giao toàn quốc 48H</p>
                </div>
            </div>
            <div class="trust-item">
                <svg width="16"
                     height="16"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     viewBox="0 0 24 24">
                    <polyline points="1 4 1 10 7 10" />
                    <path d="M3.51 15a9 9 0 1 0 .49-3.5" />
                </svg>
                <div class="trust-text">
                    <p>Đổi trả 30 ngày</p>
                    <p>Miễn phí đổi size</p>
                </div>
            </div>
        </div>

        <!-- TABS -->
        <div class="tabs-nav">
            <button class="tab-btn active" onclick="openTab(this, 'desc')">
                Mô tả
            </button>
            <button class="tab-btn" onclick="openTab(this, 'specs')">
                Thông số
            </button>
            <button class="tab-btn" onclick="openTab(this, 'auth')">
                Xác thực
            </button>
            <button class="tab-btn" onclick="openTab(this, 'reviews')">
                Reviews (86)
            </button>
        </div>

        <div class="tab-content active" id="tab-desc">
            @if (!string.IsNullOrEmpty(Model?.Content))
            {
                @Html.Raw(Model.Content)
            }
            else if (!string.IsNullOrEmpty(Model?.Description))
            {
                <p>@Model.Description</p>
            }
            else
            {
                <p style="color:var(--muted);">// Chưa có mô tả sản phẩm.</p>
            }
        </div>
        <div class="tab-content" id="tab-specs">
            <table class="spec-tbl">
                <tr><td>Tên sản phẩm</td><td>@Model?.Name</td></tr>
                <tr><td>Danh mục</td><td>@(Model?.Category?.Name ?? "—")</td></tr>
                <tr><td>Giá</td><td>@Model?.Price.ToString("N0")₫</td></tr>
                <tr><td>Số lượng kho</td><td>@Model?.Quantity</td></tr>
                <tr><td>Ngày nhập</td><td>@Model?.Created_at.ToString("dd/MM/yyyy")</td></tr>
                @if (sizes != null && sizes.Any())
                {
                    <tr>
                        <td>Size có sẵn</td>
                        <td>@string.Join(", ", sizes.Where(s => s.Quantity > 0).Select(s => s.size))</td>
                    </tr>
                }
            </table>
        </div>
        <div class="tab-content" id="tab-auth">
            <p>
                Mỗi đôi giày tại Sole District đều trải qua quy trình xác thực 12
                bước nghiêm ngặt bởi các chuyên gia sneaker với hơn 10 năm kinh
                nghiệm.
            </p>
            <table class="spec-tbl">
                <tr>
                    <td>Bước 1-4</td>
                    <td>Kiểm tra tag, box, receipt gốc</td>
                </tr>
                <tr>
                    <td>Bước 5-8</td>
                    <td>Scan QR Nike, đo đạc tỉ lệ chi tiết</td>
                </tr>
                <tr>
                    <td>Bước 9-12</td>
                    <td>Kiểm tra chất liệu, mùi, UV light test</td>
                </tr>
                <tr>
                    <td>Chứng nhận</td>
                    <td>Certificate số + QR verify online</td>
                </tr>
                <tr>
                    <td>Bảo hành</td>
                    <td>Hoàn tiền 100% nếu phát hiện fake</td>
                </tr>
            </table>
        </div>
        <div class="tab-content" id="tab-reviews">
            <div class="rev-summary">
                <div style="text-align: center">
                    <div class="rev-score-big">4.9</div>
                    <div class="rev-stars-big">★★★★★</div>
                    <div class="rev-total">86 reviews</div>
                </div>
                <div class="bar-rows">
                    <div class="bar-row">
                        <span>5★</span>
                        <div class="bar-track">
                            <div class="bar-fill" style="width: 88%"></div>
                        </div>
                        <span>76</span>
                    </div>
                    <div class="bar-row">
                        <span>4★</span>
                        <div class="bar-track">
                            <div class="bar-fill" style="width: 8%"></div>
                        </div>
                        <span>7</span>
                    </div>
                    <div class="bar-row">
                        <span>3★</span>
                        <div class="bar-track">
                            <div class="bar-fill" style="width: 3%"></div>
                        </div>
                        <span>3</span>
                    </div>
                    <div class="bar-row">
                        <span>2★</span>
                        <div class="bar-track">
                            <div class="bar-fill" style="width: 0%"></div>
                        </div>
                        <span>0</span>
                    </div>
                    <div class="bar-row">
                        <span>1★</span>
                        <div class="bar-track">
                            <div class="bar-fill" style="width: 0%"></div>
                        </div>
                        <span>0</span>
                    </div>
                </div>
            </div>
            <div class="rev-card">
                <div class="rev-top">
                    <span class="rev-name">tuan</span><span class="rev-date">12/05/2025</span>
                </div>
                <div class="rev-stars">★★★★★</div>
                <p class="rev-text">
                    Auth 100% luôn. Mình đã flex với 3 đứa bạn chuyên check giày,
                    không đứa nào nghi ngờ. Box đẹp, đủ phụ kiện. Ship nhanh hơn dự
                    kiến 1 ngày!
                </p>
            </div>
            <div class="rev-card">
                <div class="rev-top">
                    <span class="rev-name">hoang</span><span class="rev-date">08/05/2025</span>
                </div>
                <div class="rev-stars">★★★★★</div>
                <p class="rev-text">
                    Đây là lần thứ 5 mình mua ở Sole District. Lần nào cũng chill,
                    không lo fake. AJ1 lần này chất da xịn hơn cả lần trước.
                </p>
            </div>
        </div>
    </div>
    <!-- end info-panel -->
</div>
<!-- end product-detail -->
<!-- RELATED -->
<section class="related">
    <div class="rel-eyebrow">You May Also Like</div>
    <h2 class="rel-title">RELATED DROPS</h2>
    <div class="rel-grid">
        @{
            var related = ViewBag.Related as List<NguyenMinhHa_BanGiay.Models.ProductModel>;
            var colorClasses = new[] { "c-white", "c-red", "c-blue", "c-orange", "c-green", "c-black" };
            int ri = 0;
        }
        @if (related != null && related.Any())
        {
            foreach (var rel in related.Take(4))
            {
                string relUrl = Url.Action("Detail", "Product", new { Id = rel.Id });
                <div class="rel-card" onclick="window.location='@relUrl'" style="cursor:pointer;">
                    <div class="rel-img">
                        @if (!string.IsNullOrEmpty(rel.ImageUrl))
                        {
                            <img src="@rel.ImageUrl" alt="@rel.Name"
                                 style="width:120px;height:64px;object-fit:cover;border-radius:4px;" />
                        }
                        else
                        {
                            string rc = colorClasses[ri % colorClasses.Length];
                            <div class="shoe-thumb @rc" style="width:120px;height:64px">
                                <div class="s-upper" style="height:50px"></div>
                                <div class="s-sole"></div>
                                <div class="s-laces">
                                    <div class="s-lace" style="width:48px"></div>
                                    <div class="s-lace" style="width:40px"></div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="rel-info">
                        <div class="rel-brand">@(rel.Category?.Name ?? "")</div>
                        <div class="rel-name"><a href="@relUrl">@rel.Name</a></div>
                        <div class="rel-price">@rel.Price.ToString("N0")₫</div>
                    </div>
                </div>
                ri++;
            }
        }
    </div>
</section></div>