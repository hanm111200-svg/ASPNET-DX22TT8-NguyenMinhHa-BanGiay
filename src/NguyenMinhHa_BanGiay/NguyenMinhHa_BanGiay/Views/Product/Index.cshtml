@model IEnumerable<NguyenMinhHa_BanGiay.Models.ProductModel>
@{
    ViewData["Title"] = "Product";
    var categories = ViewBag.Categories as IEnumerable<dynamic>;
    var products = ViewBag.products as IEnumerable<dynamic>;
    string currentCategory = ViewBag.CurrentCategory ?? "";
    string currentSearch = ViewBag.CurrentSearch ?? "";
    string currentSort = ViewBag.CurrentSort ?? "";
}
<div class="ticker">
    <div class="ticker-track">
        <div class="ticker-item">
            MIỄN PHÍ SHIP ĐƠN TRÊN 2 TRIỆU <span class="ticker-sep">★</span> XÁC
            THỰC 100% CHÍNH HÃNG <span class="ticker-sep">★</span> ĐỔI TRẢ 30 NGÀY
            <span class="ticker-sep">★</span> DROP MỚI MỖI THỨ SÁU
            <span class="ticker-sep">★</span>
        </div>
        <div class="ticker-item">
            MIỄN PHÍ SHIP ĐƠN TRÊN 2 TRIỆU <span class="ticker-sep">★</span> XÁC
            THỰC 100% CHÍNH HÃNG <span class="ticker-sep">★</span> ĐỔI TRẢ 30 NGÀY
            <span class="ticker-sep">★</span> DROP MỚI MỖI THỨ SÁU
            <span class="ticker-sep">★</span>
        </div>
    </div>
</div>

<div class="page-top">
    <div>
        <div class="breadcrumb">
            <a href="@Url.Action("Index", "Home")">Home</a><span class="sep">/</span><span style="color: var(--text)">Sneakers</span>
        </div>
        <h1 class="page-title">
            ALL<br /><span class="outline">SNEAKERS</span>
        </h1>
        <p class="page-count">// @Model.Count() sản phẩm tìm thấy</p>
    </div>
    <div style="display: flex; gap: 12px; align-items: center">
        <button class="clear-all" onclick="window.location='@Url.Action("Index", "Product")'">Xóa bộ lọc</button>
        @{
            var baseUrl = Url.Action("Index", "Product");
            var sortUrl = $"{baseUrl}?category={currentCategory}&search={currentSearch}&sort=";
            string SelIf(string val) => currentSort == val ? "selected" : "";
        }
        <select class="sort-sel" onchange="window.location='@sortUrl'+this.value">            
            @Html.Raw($"<option value='price_asc' {SelIf("price_asc")}>Giá tăng dần</option>")
            @Html.Raw($"<option value='price_desc' {SelIf("price_desc")}>Giá giảm dần</option>")
        </select>
        <div class="view-toggle">
            <button class="vbtn active" id="grid-btn" onclick="setView('grid')">
                <svg width="14"
                     height="14"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     viewBox="0 0 24 24">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                </svg>
            </button>
            <button class="vbtn" id="list-btn" onclick="setView('list')">
                <svg width="14"
                     height="14"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     viewBox="0 0 24 24">
                    <line x1="8" y1="6" x2="21" y2="6" />
                    <line x1="8" y1="12" x2="21" y2="12" />
                    <line x1="8" y1="18" x2="21" y2="18" />
                    <line x1="3" y1="6" x2="3.01" y2="6" />
                    <line x1="3" y1="12" x2="3.01" y2="12" />
                </svg>
            </button>
        </div>
    </div>
</div>

<div class="controls">
    <div class="controls-left">
        <span style="
            font-family: var(--mono);
            font-size: 10px;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
          ">Quick Filter:</span>
        @if (categories != null)
        {
            foreach (var cat in categories)
            {
                string isActive = (currentCategory == (string)cat.Slug) ? "active" : "";
                string chipUrl = (currentCategory == (string)cat.Slug)
                ? Url.Action("Index", "Product", new { search = currentSearch, sort = currentSort })
                : Url.Action("Index", "Product", new { category = cat.Slug, search = currentSearch, sort = currentSort });
                <a href="@chipUrl" class="filter-chip @isActive">@cat.Name</a>
            }
        }
    </div>
</div>

<div class="shop-layout">
    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sb-section">
            <div class="sb-title">
                Thương hiệu
                <button class="clear-all" onclick="window.location='@Url.Action("Index", "Product")'">Xóa</button>
            </div>
            <div class="brand-list">
                @if (categories != null)
                {
                    string isAct = (currentCategory == "") ? "active" : "";
                    <a href="/product" class="brand-btn @isAct">
                        Tất cả <span class="sb-count">@products.Count()</span>
                    </a>
                    foreach (var cat in categories)
                    {
                        string isActive = (currentCategory == (string)cat.Slug) ? "active" : "";
                        string catUrl = (currentCategory == (string)cat.Slug)
                        ? Url.Action("Index", "Product", new { search = currentSearch, sort = currentSort })
                        : Url.Action("Index", "Product", new { category = cat.Slug, search = currentSearch, sort = currentSort });
                        <a href="@catUrl" class="brand-btn @isActive">
                            @cat.Name <span class="sb-count">@cat.Count</span>
                        </a>
                    }
                }
                else
                {
                    <p style="color:var(--muted);font-size:12px;">Chưa có danh mục.</p>
                }
            </div>
        </div>
    </aside>

    <!-- PRODUCTS -->
    <div class="products-area">
        <div class="active-tags">
            @if (!string.IsNullOrEmpty(currentCategory) || !string.IsNullOrEmpty(currentSearch))
            {
                <span style="font-family:var(--mono);font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.1em;">Đang lọc:</span>
                if (!string.IsNullOrEmpty(currentCategory))
                {
                    string clearCatUrl = Url.Action("Index", "Product", new { search = currentSearch, sort = currentSort });
                    <span class="a-tag">@currentCategory <a href="@clearCatUrl">×</a></span>
                }
                if (!string.IsNullOrEmpty(currentSearch))
                {
                    string clearSearchUrl = Url.Action("Index", "Product", new { category = currentCategory, sort = currentSort });
                    <span class="a-tag">Tìm: "@currentSearch" <a href="@clearSearchUrl">×</a></span>
                }
            }
        </div>

        <div class="product-grid" id="pgrid">
            @{
                var colorClasses = new[] { "c-black", "c-white", "c-blue", "c-red", "c-green", "c-purple", "c-orange", "c-grey" };
                int idx = 0;
            }
            @if (!Model.Any())
            {
                <div style="grid-column: 1/-1; padding: 60px; text-align:center; color: var(--muted); font-family: var(--mono);">
                    // Không tìm thấy sản phẩm nào.
                </div>
            }
            @foreach (var product in Model)
            {
                string colorClass = colorClasses[idx % colorClasses.Length];
                string detailUrl = Url.Action("Detail", "Product", new { Id = product.Id });
                <div class="product-card">
                    <div class="card-img">
                        @if (product.Status == 2)
                        {
                            <span class="card-badge sale">Sale</span>
                        }
                        else if ((DateTime.Now - product.Created_at).TotalDays <= 7)
                        {
                            <span class="card-badge new">New</span>
                        }                        
                        @if (product.ImageUrl != null)
                        {
                            <img src="@Url.Content("~/upload/product/" + @product.ImageUrl)" alt="@product.Name" />
                        }
                        else
                        {
                            <div class="shoe-thumb @colorClass" style="width:130px;height:70px">
                                <div class="s-upper" style="height:54px"></div>
                                <div class="s-sole"></div>
                                <div class="s-laces">
                                    <div class="s-lace" style="width:52px"></div>
                                    <div class="s-lace" style="width:44px"></div>
                                </div>
                            </div>
                        }
                        <div class="card-overlay">
                            <button class="ov-btn" onclick="window.location='@detailUrl'">Xem ngay</button>                            
                        </div>
                    </div>
                    <div class="card-info">
                        <div class="card-brand">@(product.Category?.Name ?? "")</div>
                        <div class="card-name">
                            <a href="@detailUrl">@product.Name</a>
                        </div>
                        @if (!string.IsNullOrEmpty(product.Description))
                        {
                            <div class="card-desc">@product.Description</div>
                        }
                        <div class="card-footer">
                            <span class="card-price">@product.Price.ToString("N0")₫</span>
                            @if (product.ProductSizes != null && product.ProductSizes.Any())
                            {
                                <div class="card-sizes">
                                    @foreach (var size in product.ProductSizes.Take(4))
                                    {
                                        <span class="sz">@size.Size</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
                idx++;
            }
        </div>
        <!-- end grid -->
    </div>
</div>