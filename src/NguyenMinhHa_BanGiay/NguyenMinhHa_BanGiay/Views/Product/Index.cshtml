            <div class="sb-title">Tình trạng</div>
            <div class="sb-opt">
                <label><input type="checkbox" checked /> Còn hàng</label>
            </div>
            <div class="sb-opt">
                <label><input type="checkbox" /> Pre-order</label>
            </div>
            <div class="sb-opt">
                <label><input type="checkbox" /> Hết hàng</label>
