@model IEnumerable<ProductModel>
@{
	ViewData["Title"] = "Product";
}
<div class="ticker">
    <div class="ticker-track">
        <div class="ticker-item">
            MIỄN PHÍ SHIP ĐƠN TRÊN 2 TRIỆU <span class="ticker-sep">★</span> XÁC
            THỰC 100% CHÍNH HÃNG <span class="ticker-sep">★</span> ĐỔI TRẢ 30 NGÀY
            <span class="ticker-sep">★</span> DROP MỚI MỖI THỨ SÁU
            <span class="ticker-sep">★</span>
        </div>
        <div class="ticker-item">
            MIỄN PHÍ SHIP ĐƠN TRÊN 2 TRIỆU <span class="ticker-sep">★</span> XÁC
            THỰC 100% CHÍNH HÃNG <span class="ticker-sep">★</span> ĐỔI TRẢ 30 NGÀY
            <span class="ticker-sep">★</span> DROP MỚI MỖI THỨ SÁU
            <span class="ticker-sep">★</span>
        </div>
    </div>
</div>

<div class="page-top">
    <div>
        <div class="breadcrumb">
            <a href="sole-index.html">Home</a><span class="sep">/</span><span style="color: var(--text)">Sneakers</span>
        </div>
        <h1 class="page-title">
            ALL<br /><span class="outline">SNEAKERS</span>
        </h1>
        <p class="page-count">// 48 sản phẩm tìm thấy</p>
    </div>
    <div style="display: flex; gap: 12px; align-items: center">
        <button class="clear-all" onclick="clearAll()">Xóa bộ lọc</button>
        <select class="sort-sel">
            <option>Mới nhất</option>
            <option>Bán chạy</option>
            <option>Giá tăng dần</option>
            <option>Giá giảm dần</option>
        </select>
        <div class="view-toggle">
            <button class="vbtn active" id="grid-btn" onclick="setView('grid')">
                <svg width="14"
                     height="14"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     viewBox="0 0 24 24">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                </svg>
            </button>
            <button class="vbtn" id="list-btn" onclick="setView('list')">
                <svg width="14"
                     height="14"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     viewBox="0 0 24 24">
                    <line x1="8" y1="6" x2="21" y2="6" />
                    <line x1="8" y1="12" x2="21" y2="12" />
                    <line x1="8" y1="18" x2="21" y2="18" />
                    <line x1="3" y1="6" x2="3.01" y2="6" />
                    <line x1="3" y1="12" x2="3.01" y2="12" />
                </svg>
            </button>
        </div>
    </div>
</div>

<div class="controls">
    <div class="controls-left">
        <span style="
            font-family: var(--mono);
            font-size: 10px;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
          ">Quick Filter:</span>
        <button class="filter-chip active"
                onclick="this.classList.toggle('active')">
            Tất cả
        </button>
        <button class="filter-chip" onclick="this.classList.toggle('active')">
            Nike
        </button>
        <button class="filter-chip" onclick="this.classList.toggle('active')">
            Jordan
        </button>
        <button class="filter-chip" onclick="this.classList.toggle('active')">
            Adidas
        </button>
        <button class="filter-chip" onclick="this.classList.toggle('active')">
            New Balance
        </button>
        <button class="filter-chip" onclick="this.classList.toggle('active')">
            Sale 🔥
        </button>
        <button class="filter-chip" onclick="this.classList.toggle('active')">
            Limited
        </button>
    </div>
</div>

