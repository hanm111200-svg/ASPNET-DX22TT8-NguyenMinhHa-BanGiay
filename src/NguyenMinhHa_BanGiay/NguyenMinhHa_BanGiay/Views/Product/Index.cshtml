                <div class="c-swatch"
                     style="background: var(--accent)"
                     title="Vàng"></div>
            </div>
        </div>
        <div class="sb-section">
            <div class="sb-title">Danh mục</div>
            <div class="sb-opt">
                <label><input type="checkbox" checked /> Running</label><span class="sb-count">124</span>
            </div>
            <div class="sb-opt">
                <label><input type="checkbox" checked /> Lifestyle</label><span class="sb-count">89</span>
            </div>
            <div class="sb-opt">
