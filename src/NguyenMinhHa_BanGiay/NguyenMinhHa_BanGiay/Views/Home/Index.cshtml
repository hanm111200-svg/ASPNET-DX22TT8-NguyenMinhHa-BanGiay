<!-- CATEGORIES -->
<div class="sec-hd">
    <div>
        <div class="sec-eyebrow">Shop by Style</div>
        <h2 class="sec-title">DANH<br /><span class="outline">MỤC</span></h2>
    </div>
</div>
<div class="categories">
    <div class="cat-grid">
        @if (categories != null && categories.Any())
        {
            var catColors = new[] { "c-black", "c-white", "c-red", "c-blue", "c-green", "c-purple", "c-orange" };
            int ci = 0;
            foreach (var cat in categories)
            {
                string catColor = catColors[ci % catColors.Length];
                <div class="cat-card" onclick="window.location='@Url.Action("Index", "Product", new { slug = cat.Slug })'">
                    <div class="cat-icon">
                        <div class="shoe-thumb @catColor" style="width: 64px; height: 36px">
                            <div class="s-upper" style="height: 26px"></div>
                            <div class="s-sole"></div>
                        </div>
                    </div>
                    <div class="cat-name">@cat.Name.ToUpper()</div>
                </div>
                ci++;
            }
        }
        else
        {
            <p style="color:var(--muted);">Chưa có danh mục nào.</p>
        }
    </div>
</div>

