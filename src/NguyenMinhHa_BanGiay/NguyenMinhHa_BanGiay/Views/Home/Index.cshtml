</div>

<!-- HERO -->
<section class="hero">
    <div class="hero-left">
        <div class="hero-tag">New Drop — SS2025</div>
        <h1 class="hero-title">
            WEAR<br />
            THE<br />
            <span class="accent">STREETS</span>
        </h1>
        <p class="hero-sub">
            Không chỉ là giày — đây là tuyên ngôn của bạn. Sneakers chính hãng,
            phiên bản giới hạn, giao nhanh toàn quốc.
        </p>
        <div class="hero-ctas">
            <a href="/Product" class="btn-primary">
                Shop Now
                <svg width="16"
                     height="16"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     viewBox="0 0 24 24">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
            </a>
        </div>
        <div class="hero-stats">
            <div class="stat">
                <div class="stat-num">500+</div>
                <div class="stat-label">Mẫu giày</div>
            </div>
            <div class="stat">
                <div class="stat-num">100%</div>
                <div class="stat-label">Chính hãng</div>
            </div>
            <div class="stat">
                <div class="stat-num">48H</div>
                <div class="stat-label">Giao hàng</div>
            </div>
        </div>
    </div>

    <div class="hero-right">
        <div class="hero-shoe-display">
            <div class="shoe-visual">
                <div class="shoe-body">
                    <div class="shoe-upper">
                        <div class="shoe-laces">
                            <div class="lace" style="width: 80px"></div>
                            <div class="lace" style="width: 68px"></div>
                            <div class="lace" style="width: 56px"></div>
                            <div class="lace" style="width: 44px"></div>
                        </div>
                    </div>
                    <div class="shoe-sole"></div>
                    <div class="shoe-logo-mark">SD</div>
                </div>
                <div class="shoe-tag">NEW DROP</div>
            </div>
            <div class="hero-badge-row">
                <span class="hero-badge lit">Limited</span>
                <span class="hero-badge">Size 36–46</span>
                <span class="hero-badge">Auth Verified</span>
            </div>
        </div>
        <div class="hero-scroll">SCROLL DOWN</div>
    </div>
</section>

<!-- BRANDS -->
<div class="brands-strip">
    <span class="brands-label">Official Brands</span>
    <div class="brands-list">
        @if (categories != null && categories.Any())
        {
            foreach (var cat in categories)
            {               
                <span class="brand-name">@cat.Name.ToUpper()</span>
            }
        }
        @* <span class="brand-name">NIKE</span>
        <span class="brand-name">ADIDAS</span>
        <span class="brand-name">NEW BALANCE</span>
        <span class="brand-name">JORDAN</span>
        <span class="brand-name">CONVERSE</span>
        <span class="brand-name">VANS</span>
        <span class="brand-name">PUMA</span>
        <span class="brand-name">REEBOK</span>
        <span class="brand-name">ASICS</span> *@
    </div>
</div>

<!-- FEATURED PRODUCTS -->
<div class="sec-hd">
    <div>
        <div class="sec-eyebrow">Hot This Week</div>
        <h2 class="sec-title">
            BEST<br /><span class="outline">SELLERS</span>
        </h2>
    </div>
    <a href="/Product" class="view-all-link">Xem tất cả →</a>
</div>

<div class="product-grid">
    @if (products != null && products.Any())
    {
        var colorClasses = new[] { "c-black", "c-white", "c-blue", "c-red", "c-green", "c-purple", "c-orange", "c-grey" };
        int idx = 0;
        foreach (var product in products.Take(6))
        {
            bool isFeatured = idx == 0;
            string colorClass = colorClasses[idx % colorClasses.Length];
            string featuredClass = isFeatured ? "featured" : "";
            int thumbW = isFeatured ? 220 : 160;
            int thumbH = isFeatured ? 130 : 90;
            int upperH = isFeatured ? 100 : 65;
            <div class="product-card @featuredClass">
                <div class="card-img">
                    @if (product.Status == 2)
                    {
                        <span class="card-badge sale">Sale</span>
                    }
                    else if ((DateTime.Now - product.Created_at).TotalDays <= 7)
                    {
                        <span class="card-badge new">New</span>
                    }
                    @if (product.ImageUrl != null)
                    {
                        <img src="@Url.Content("~/upload/product/" + @product.ImageUrl)" alt="@product.Name"/>
                    }
                    else
                    {
                        <div class="shoe-thumb @colorClass" style="width:@(thumbW)px;height:@(thumbH)px">
                            <div class="s-upper" style="height:@(upperH)px"></div>
                            <div class="s-sole"></div>
                            <div class="s-laces">
                                <div class="s-lace" style="width:@(isFeatured ? 90 : 50)px"></div>
                                <div class="s-lace" style="width:@(isFeatured ? 76 : 40)px"></div>
                                @if (isFeatured)
                                {
                                    <div class="s-lace" style="width:62px"></div>
                                }
                            </div>
                        </div>
                    }
                    <div class="card-overlay">
                        <button class="ov-btn"
                                onclick="window.location='@Url.Action("Detail", "Product", new { id = product.Id })'">Xem Chi Tiết                            
                        </button>                        
                    </div>
                </div>
                <div class="card-info">
                    <div class="card-brand">@(product.Category?.Name ?? "Uncategorized")</div>
                    <div class="card-name">
                        <a href="@Url.Action("Detail", "Product", new { slug = product.Slug })">@product.Name</a>
                    </div>
                    <div class="card-footer">
                        <span class="card-price">@product.Price.ToString("N0")₫</span>
                        @if (product.ProductSizes != null && product.ProductSizes.Any())
                        {
                            <div class="card-sizes">
                                @foreach (var size in product.ProductSizes.Take(4))
                                {
                                    <span class="sz">@size.Size</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            idx++;
        }
    }
    else
    {
        <p style="color:var(--muted);padding:2rem;">Chưa có sản phẩm nào.</p>
    }
</div>

<!-- MARQUEE -->
<div class="big-marquee">
    <div class="big-marquee-track">
        <div class="big-marquee-item">
            SNEAKER HEAD <span>·</span> STREET CULTURE <span>·</span> AUTHENTIC
            ONLY <span>·</span> SOLE DISTRICT <span>·</span> WEAR YOUR STORY
            <span>·</span>
        </div>
        <div class="big-marquee-item">
