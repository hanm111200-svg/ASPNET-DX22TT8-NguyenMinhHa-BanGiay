@using NguyenMinhHa_BanGiay.Models
@using NguyenMinhHa_BanGiay.Extensions
@{
    ViewData["Title"] = "Checkout";
    var cart = Context.Session.GetObjectFromJson<List<CartModel>>("cart") ?? new List<CartModel>();
    decimal cartTotal = cart.Sum(i => i.Price * i.Quantity);
}

<!-- TICKER -->
<div class="ticker">
    <div class="ticker-track">
        <div class="ticker-item">
            XÁC THỰC 100% CHÍNH HÃNG <span class="ticker-sep">★</span> ĐỔI TRẢ 30
            NGÀY <span class="ticker-sep">★</span> THANH TOÁN BẢO MẬT SSL
            <span class="ticker-sep">★</span> GIAO HÀNG TOÀN QUỐC
            <span class="ticker-sep">★</span>
        </div>
        <div class="ticker-item">
            XÁC THỰC 100% CHÍNH HÃNG <span class="ticker-sep">★</span> ĐỔI TRẢ 30
            NGÀY <span class="ticker-sep">★</span> THANH TOÁN BẢO MẬT SSL
            <span class="ticker-sep">★</span> GIAO HÀNG TOÀN QUỐC
            <span class="ticker-sep">★</span>
        </div>
    </div>
</div>

<div class="page-wrap">
    <!-- STEPS -->
    <div class="steps-bar">
        <div class="step done"><span class="step-num">✓</span>Cart</div>
        <div class="step-line"></div>
        <div class="step active"><span class="step-num">2</span>Info</div>
        <div class="step-line"></div>
        <div class="step"><span class="step-num">3</span>Payment</div>
    </div>

    <div class="checkout-layout">
        <!-- FORM PANEL -->
        <form asp-controller="Checkout" asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <div class="form-panel">
                <!-- CONTACT -->
                <div class="blk">
                    <div class="blk-eyebrow">Step 01</div>
                    <h2 class="blk-title">CONTACT INFO</h2>

                    <div class="field-row">
                        <div class="field">
                            <label>Họ và Tên</label>
                            <input type="text" placeholder="Tên của bạn" id="fName" name="name" required />
                        </div>
                        <div class="field">
                            <label>Địa chỉ</label>
                            <input type="text" placeholder="Địa chỉ giao hàng" id="faddress" name="address" required />
                        </div>
                    </div>
                    <div class="field-row">
                        <div class="field">
                            <label>Email</label>
                            <div class="inp-wrap">
                                <input type="email"
                                       placeholder="you@email.com"
                                       id="email" name="email"
                                       class="ok" required />
                                <span class="inp-icon ok">
                                    <svg width="14"
                                         height="14"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         viewBox="0 0 24 24">
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg>
                                </span>
                            </div>
                        </div>
                        <div class="field">
                            <label>Số điện thoại</label>
                            <div class="inp-wrap">
                                <input type="tel" placeholder="0901 234 567" id="phone" name="phone" required />
                                <span class="inp-icon">
                                    <svg width="13"
                                         height="13"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.5"
                                         viewBox="0 0 24 24">
                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.9a16 16 0 0 0 6.16 6.16l.92-.92a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                                    </svg>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="blk-divider" />         
                
                <h3 class="step-title">02 / PHƯƠNG THỨC THANH TOÁN</h3>
                <div class="pay-methods-container" style="margin-bottom: 32px;">
                    <input type="hidden" name="paymentmethod" id="selectedPaymentMethod" value="1" />

                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">

                        <div class="pay-method-card" onclick="selectPaymentMethod(this, '1')" style="border: 2px solid var(--accent); padding: 16px; border-radius: 4px; cursor: pointer; text-align: center; background: #111; transition: all 0.2s;">
                            <div style="font-size: 24px; margin-bottom: 8px;">💵</div>
                            <div style="font-weight: bold; font-size: 14px; text-transform: uppercase; color: #fff;">Trực tiếp (COD)</div>
                            <div style="font-size: 11px; color: var(--muted); margin-top: 4px;">Thanh toán khi nhận hàng</div>
                        </div>

                        @* <div class="pay-method-card" onclick="selectPaymentMethod(this, '2')" style="border: 2px solid #333; padding: 16px; border-radius: 4px; cursor: pointer; text-align: center; background: #111; transition: all 0.2s;"> *@
                        @*     <div style="font-size: 24px; margin-bottom: 8px;">🌸</div> *@
                        @*     <div style="font-weight: bold; font-size: 14px; text-transform: uppercase; color: #fff;">Ví MoMo</div> *@
                        @*     <div style="font-size: 11px; color: var(--muted); margin-top: 4px;">Thanh toán qua app MoMo</div> *@
                        @* </div> *@

                        <div class="pay-method-card" onclick="selectPaymentMethod(this, '3')" style="border: 2px solid #333; padding: 16px; border-radius: 4px; cursor: pointer; text-align: center; background: #111; transition: all 0.2s;">
                            <div style="font-size: 24px; margin-bottom: 8px;">💳</div>
                            <div style="font-weight: bold; font-size: 14px; text-transform: uppercase; color: #fff;">Cổng VNPay</div>
                            <div style="font-size: 11px; color: var(--muted); margin-top: 4px;">Thẻ ATM / Thẻ quốc tế</div>
                        </div>

                    </div>
                </div>

                <!-- AGREE & SUBMIT -->
                <div>
                    <!-- Hidden fields cho controller -->
                    <input type="hidden" name="subtotal" id="hSubtotal" value="@cartTotal" />
                    <input type="hidden" name="discount" id="hDiscount" value="0" />
                    <input type="hidden" name="total" id="hTotal" value="@cartTotal" />
                    <input type="hidden" name="paymentmethod" id="hPaymentmethod" value="1" />

                    <label class="check-row">
                        <input type="checkbox" id="agreeTerms" checked /><span>
                            Tôi đồng ý với <a href="#">Điều khoản dịch vụ</a> và
                            <a href="#">Chính sách bảo mật</a> của Sole District
                        </span>
                    </label>
                    <button type="submit" class="btn-order" id="orderBtn" onclick="return validateCheckout()">
                        <svg width="16"
                             height="16"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             viewBox="0 0 24 24">
                            <rect x="3" y="11" width="18" height="11" rx="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                        Đặt hàng — @cartTotal.ToString("N0")₫
                    </button>
                    <button class="btn-back-link" onclick="history.back()">
                        ← Quay lại giỏ hàng
                    </button>
                </div>
            </div>
        </form>
        <!-- end form-panel -->
        <!-- ORDER PANEL -->
        <div class="order-panel">
            <h2 class="op-title">ORDER<br />SUMMARY</h2>

            <div class="op-items">
                @foreach (var item in cart)
                {
                    <div class="op-item">
                        <div class="op-img">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@Url.Content("~/upload/product/" + item.ImageUrl)"
                                     style="width:48px;height:48px;object-fit:cover;border-radius:4px;" />
                            }
                            else
                            {
                                <div class="op-img-shoe c-black">
                                    <div class="s-upper"></div>
                                    <div class="s-sole"></div>
                                </div>
                            }
                            <span class="op-qty">@item.Quantity</span>
                        </div>
                        <div class="op-info">
                            <div class="op-name">@item.Name</div>
                            @if (!string.IsNullOrEmpty(item.Size))
                            {
                                <div class="op-meta">Size: @item.Size</div>
                            }
                            <div class="op-auth">
                                <svg width="9" height="9" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>Auth Verified
                            </div>
                        </div>
                        <div class="op-price">@item.Total.ToString("N0")₫</div>
                    </div>
                }
            </div>

            <div class="op-row">
                <span class="l">Tạm tính</span><span class="v">@cartTotal.ToString("N0")₫</span>
            </div>
            <div class="op-row">
                <span class="l">Giảm giá</span><span class="v disc">−0₫</span>
            </div>
            <div class="op-row">
                <span class="l">Vận chuyển</span><span class="v free">Miễn phí</span>
            </div>
            <div class="op-row">
                <span class="l">VAT (10%)</span><span class="v">Đã bao gồm</span>
            </div>
            <hr class="op-div" />
            <div class="op-total">
                <span class="l">Total</span><span class="v">@cartTotal.ToString("N0")₫</span>
            </div>
            <p class="op-vat">// Đã bao gồm VAT 10%</p>           
        </div>
        <!-- end order-panel -->
    </div>
    <!-- end checkout-layout -->
</div>
<!-- end page-wrap -->
<script>
        function setPayment(val) {
            document.getElementById('hPaymentmethod').value = val;
        }
        function validateCheckout() {
            var fname = (document.getElementById('fName').value || '').trim();
            var lname = (document.getElementById('lName').value || '').trim();
            var nameInput = document.querySelector('input[name="name"]');
            if (fname || lname) nameInput.value = (fname + ' ' + lname).trim();

            var addrInput = document.getElementById('address');
            if (!addrInput.value.trim()) {
                var savedAddr = document.querySelector('.addr-card.active .addr-detail');
                if (savedAddr) addrInput.value = savedAddr.innerText.replace(/
    /g, ', ');
            }
            var agreed = document.getElementById('agreeTerms').checked;
            if (!agreed) { alert('Vui lòng đồng ý với điều khoản dịch vụ!'); return false; }
            return true;
        }
</script>
<!-- SUCCESS MODAL -->
<div class="modal-overlay" id="successModal">
    <div class="modal">
        <div class="modal-icon">
            <svg width="28"
                 height="28"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.5"
                 viewBox="0 0 24 24">
                <polyline points="20 6 9 17 4 12" />
            </svg>
        </div>
        <div class="modal-eyebrow">// Order confirmed</div>
        <h2 class="modal-title">YOU'RE<br />ALL SET!</h2>
        <p class="modal-order">Order ID: <strong>#SD-2025-04721</strong></p>
        <p class="modal-desc">
            Đơn hàng đã được xác nhận. Chúng tôi sẽ gửi email xác nhận và tracking
            link ngay sau khi đóng gói. Dự kiến giao trong 3–5 ngày làm việc.
        </p>
        <div class="modal-btns">
            <a href="@Url.Action("Index", "Home")" class="modal-btn-primary">← Tiếp tục mua sắm</a>
            <button class="modal-btn-sec" onclick="closeModal()">
                Track Order →
            </button>
        </div>
    </div>
</div>

<script>
    // Hàm xử lý khi người dùng chọn phương thức thanh toán
    function selectPaymentMethod(element, methodValue) {
        // 1. Xóa viền active của tất cả các phương thức khác
        document.querySelectorAll('.pay-method-card').forEach(card => {
            card.classList.remove('active');
            card.style.borderColor = '#333';
        });

        // 2. Kích hoạt viền sáng cho phương thức vừa chọn
        element.classList.add('active');
        element.style.borderColor = 'var(--accent)';

        // 3. Nạp giá trị chuỗi số ("1", "2" hoặc "3") vào input ẩn gửi lên Server
        var methodInput = document.getElementById('selectedPaymentMethod');
        if (methodInput) {
            methodInput.value = methodValue;
        }

        console.log("=== ĐÃ CHỌN PHƯƠNG THỨC THANH TOÁN ===");
        console.log("Mã code gửi đi:", methodValue); // Sẽ in ra 1, 2, hoặc 3 tương ứng
    }
</script>