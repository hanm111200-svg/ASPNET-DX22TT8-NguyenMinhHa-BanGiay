@{
    ViewData["Title"] = "Approve";
}
<canvas id="particle-canvas"></canvas>

<div class="ticker">
    <div class="ticker-track">
        <div class="ticker-item">
            ORDER CONFIRMED <span class="ticker-sep">★</span> THANK YOU FOR
            SHOPPING WITH US <span class="ticker-sep">★</span> AUTH VERIFIED
            <span class="ticker-sep">★</span> TRACKING EMAIL SENT
            <span class="ticker-sep">★</span>
        </div>
        <div class="ticker-item">
            ORDER CONFIRMED <span class="ticker-sep">★</span> THANK YOU FOR
            SHOPPING WITH US <span class="ticker-sep">★</span> AUTH VERIFIED
            <span class="ticker-sep">★</span> TRACKING EMAIL SENT
            <span class="ticker-sep">★</span>
        </div>
    </div>
</div>

<div class="success-hero" style="display: flex; justify-content: center; align-items: center; min-height: 60vh; padding: 40px 20px; text-align: center;">

    <div class="hero-left" style="display: flex; flex-direction: column; align-items: center; justify-content: center; max-width: 650px; margin: 0 auto;">

        <div class="check-wrap" style="display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
            <svg width="48"
                 height="48"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.5"
                 viewBox="0 0 24 24">
                <polyline points="20 6 9 17 4 12" />
            </svg>
        </div>

        <div class="hero-eyebrow" style="text-transform: uppercase; letter-spacing: 0.2em; font-size: 13px; margin-bottom: 12px; color: var(--muted);">
            // Order confirmed
        </div>

        <h1 class="hero-title" style="font-size: clamp(48px, 8vw, 80px); line-height: 0.9; margin-bottom: 24px; text-align: center;">
            YOU <span class="out" style="-webkit-text-stroke: 1px var(--text); color: transparent;">GOT</span> <span class="acc" style="color: var(--accent);">THEM!</span>
        </h1>

        <p class="hero-sub" style="font-size: 15px; color: var(--text); line-height: 1.6; max-width: 500px; margin: 0 auto; opacity: 0.85;">
            Cú cop chuẩn chỉnh! Đơn hàng của bạn đã được xác nhận và đang được đóng gói. Email xác nhận đã gửi đến hộp thư của bạn.
        </p>

        <div style="margin-top: 36px;">
            <a href="@Url.Action("Index", "Home")" style="display: inline-block; padding: 14px 32px; background: var(--text); color: var(--bg); font-family: var(--mono); font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.1em; border-radius: 4px; transition: all 0.2s;">
                ← Tiếp Tục Mua Sắm
            </a>
        </div>
    </div>
</div>

<div class="result-marquee">
    <div class="rm-track">
        <div class="rm-item">
            ORDER CONFIRMED <span class="acc">✦</span> YOU GOT THEM
            <span class="acc">✦</span> SOLE DISTRICT
            <span class="acc">✦</span> STAY FRESH <span class="acc">✦</span> AUTH
            ONLY <span class="acc">✦</span>
        </div>
        <div class="rm-item">
            ORDER CONFIRMED <span class="acc">✦</span> YOU GOT THEM
            <span class="acc">✦</span> SOLE DISTRICT
            <span class="acc">✦</span> STAY FRESH <span class="acc">✦</span> AUTH
            ONLY <span class="acc">✦</span>
        </div>
    </div>
</div>