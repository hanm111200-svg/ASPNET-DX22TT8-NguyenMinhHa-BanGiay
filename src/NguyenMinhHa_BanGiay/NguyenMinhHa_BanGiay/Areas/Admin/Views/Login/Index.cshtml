@{
    ViewData["Title"] = "Login Admin";
}
<style>
    body {
        background: #f2ede6 !important;
    }

    .authentication-wrapper {
        min-height: calc(100vh - 64px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
    }

    .authentication-inner {
        width: 100%;
        max-width: 580px;
    }

    .card {
        border: none !important;
        border-radius: 0 !important;
        box-shadow: 0 4px 40px rgba(0,0,0,0.07) !important;
        background: #faf9f7 !important;
    }

    .card-body {
        padding: 44px 40px !important;
    }

    .app-brand {
        text-align: center;
        margin-bottom: 28px !important;
    }

    .app-brand-text {
        font-family: "Cormorant Garamond", serif !important;
        font-size: 26px !important;
        font-weight: 400 !important;
        letter-spacing: 0.15em !important;
        color: #111110 !important;
        text-transform: uppercase !important;
    }

    .form-label {
        font-size: 11px !important;
        letter-spacing: 0.12em !important;
        text-transform: uppercase !important;
        font-weight: 500 !important;
        color: #111110 !important;
        margin-bottom: 6px !important;
    }

    .form-control {
        border-radius: 0 !important;
        border: 1px solid #c8c4bc !important;
        background: #faf9f7 !important;
        font-size: 14px !important;
        padding: 11px 14px !important;
        color: #111110 !important;
        box-shadow: none !important;
    }

        .form-control:focus {
            border-color: #111110 !important;
            box-shadow: none !important;
        }

    .input-group-text {
        border-radius: 0 !important;
        border: 1px solid #c8c4bc !important;
        border-left: none !important;
        background: #faf9f7 !important;
        color: #8a8880 !important;
        cursor: pointer;
    }

    .input-group .form-control {
        border-right: none !important;
    }

    .d-flex.justify-content-between a small {
        font-size: 11px !important;
        color: #8a8880 !important;
        letter-spacing: 0.03em;
        text-decoration: none;
        border-bottom: 1px solid #c8c4bc;
        padding-bottom: 1px;
    }

    .d-flex.justify-content-between a:hover small {
        color: #111110 !important;
    }

    .mb-3 {
        margin-bottom: 16px !important;
    }

    .btn-primary {
        background: #111110 !important;
        border: none !important;
        border-radius: 0 !important;
        font-size: 12px !important;
        letter-spacing: 0.15em !important;
        text-transform: uppercase !important;
        font-weight: 500 !important;
        padding: 13px !important;
        margin-top: 4px;
        transition: background 0.3s !important;
    }

        .btn-primary:hover {
            background: #2a2926 !important;
        }
</style>

<div class="container-xxl">
    <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner">
            <div class="card">
                <div class="card-body">
                    <div class="app-brand justify-content-center">
                        <a href="#" class="app-brand-link gap-2">
                            <span class="app-brand-text demo text-body text-uppercase fw-bolder">Đăng nhập</span>
                        </a>
                    </div>                  
                    <form id="formAuthentication" class="mb-3" method="post" asp-action="Index">
                        <div class="mb-3">
                            <label for="email" class="form-label">Email or Phone</label>
                            <input type="text"
                                   class="form-control"
                                   id="username"
                                   name="username"                                   
                                   placeholder="Enter your email or username"
                                   autofocus />
                        </div>
                        <div class="mb-3 form-password-toggle">
                            <div class="d-flex justify-content-between">
                                <label class="form-label" for="password">Mật khẩu</label>
                                <a asp-action="ForgotPassword" asp-controller="Login">
                                    <small>Quên mật khẩu?</small>
                                </a>
                            </div>
                            <div class="input-group input-group-merge">
                                <input type="password"
                                       id="password"
                                       class="form-control"
                                       name="password"
                                       placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;"
                                       aria-describedby="password" />
                                <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                            </div>
                        </div>                        
                        <div class="mb-3">
                            <button class="btn btn-primary d-grid w-100" type="submit">Đăng nhập</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>