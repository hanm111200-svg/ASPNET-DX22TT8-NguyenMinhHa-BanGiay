@model NguyenMinhHa_BanGiay.Models.ProductSizeModel
<div class="modal fade" id="updateProductSize" data-bs-backdrop="static" tabindex="-1">
    <div class="modal-dialog">
        <form class="modal-content" method="post" asp-controller="Product" asp-action="EditModal" enctype="multipart/form-data" id="frmUpdateOrderDetail">
            <div class="modal-header">
                <h5 class="modal-title" id="backDropModalTitle">Sửa size</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2">
                    <input type="hidden" value="" id="productsizeid" name="Id" />
                    <div class="col mb-0">
                        <label for="quantityBackdrop" class="form-label">Size</label>
                        <input type="text" id="size" class="form-control" asp-for="Size" />
                    </div>
                    <div class="col mb-0">
                        <label for="quantityBackdrop" class="form-label">Số lượng</label>
                        <input type="text" id="quantity" class="form-control" asp-for="Quantity" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Đóng
                </button>
                <button type="submit" class="btn btn-primary">Lưu</button>
            </div>
        </form>
    </div>
</div>
